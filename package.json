{
    "name": "finance-cabinet",
    "version": "1.0.0",
    "description": "Finance cabinet built with Vue 3 and Material Design",
    "private": true,
    "scripts": {
        "dev": "node scripts/build-material.cjs --watch",
        "development": "npm run build:material",
        "watch": "npm run dev",
        "watch-poll": "npm run dev",
        "build": "npm run build:material",
        "prod": "npm run build:material",
        "production": "npm run build:material",
        "build:material": "node scripts/build-material.cjs",
        "test": "npm run test:material",
        "test:material": "node --test tests/frontend/material.test.cjs"
    },
    "dependencies": {
        "vue": "3.5.33"
    }
}
